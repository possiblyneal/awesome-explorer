#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/detect.sh
source "$repo_root/scripts/libs/detect.sh"

# The shared policy: orphan search before the checks, which would run green over
# the package none of them sees; the no-manifest early-out; the dry run.
capability_command check lint format-check typecheck test build
