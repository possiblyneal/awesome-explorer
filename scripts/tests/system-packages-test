#!/usr/bin/env bash
set -uo pipefail

# Asserts what scripts/system-packages reads out of .github/system-packages.txt
# and, more importantly, what it refuses. The file is hand-written and the
# consequence of misreading it is an opaque compile error much later in CI, so
# every ambiguous line has to fail here and say why.
#
# Covered: an absent manifest, comments and blank lines, a comments-only file,
# each refusal a line can earn including every apt action suffix and every glob
# metacharacter, a version-pinned name surviving them, and an unreadable
# manifest. install must reach apt-get with exactly the packages the host lacks
# -- all of them, some of them, a pinned name whose installed version differs
# -- reach it not at all where the host has every one, where a pin is satisfied
# exactly, where dpkg-query answers with one record per architecture, or where
# there is no file, and fail naming only the absent packages where root cannot
# be reached. The multi-architecture case renders the caller's own -f= format
# rather than a fixed string, so dropping the newline from it fails the case
# rather than passing on a separator the stub supplied.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/harness.sh
source "$repo_root/scripts/tests/libs/harness.sh"

# Writes the manifest from stdin.
manifest() {
  mkdir -p "$work/.github"
  cat > "$work/.github/system-packages.txt"
}

# A sudo that logs what it was asked to run and succeeds, including the
# `sudo -n apt-get --version` probe install makes before deciding it can reach root.
sudo_logging() {
  stub sudo <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$PWD/sudo.log"
STUB
}

# A dpkg-query reporting every package in $1 installed and every other name
# absent. Each token is `name` or `name=version`, and the stub answers on the
# name alone, because that is what install queries with: the version in a
# token is what dpkg reports back, not what it is asked about. Writing that
# the other way round is how the pin case ends up asserting absence.
dpkg_holding() {
  local held=$1
  stub dpkg-query <<STUB
#!/usr/bin/env bash
for held in $held; do
  [[ "\${*: -1}" == "\${held%%=*}" ]] && { echo "install ok installed|\${held#*=}"; exit 0; }
done
exit 1
STUB
}

echo "system-packages-test"

# The absent file is the state every repository is in until one of its builds
# needs a header, so it must cost nothing and say nothing.
fixture "no manifest lists nothing and succeeds"
out="$(cd "$work" && scripts/system-packages list 2>&1)"
status=$?
if (( status == 0 )) && [[ -z $out ]]; then
  pass
else
  fail "expected silence and exit 0, got status $status: $out"
fi

fixture "comments, blank lines, and trailing comments are stripped"
manifest <<'TXT'
# headers for cpal
libasound2-dev

pkg-config   # resolves the .pc file
TXT
out="$(cd "$work" && scripts/system-packages list 2>&1)"
if [[ $out == "libasound2-dev"$'\n'"pkg-config" ]]; then
  pass
else
  fail "expected two packages in file order, got: $out"
fi

# A file holding only commentary is a repository that wrote the manifest and
# has nothing to install yet. Silence, not a failure.
fixture "a comments-only manifest lists nothing and succeeds"
manifest <<'TXT'
# nothing needed yet

TXT
out="$(cd "$work" && scripts/system-packages list 2>&1)"
status=$?
if (( status == 0 )) && [[ -z $out ]]; then
  pass
else
  fail "expected silence and exit 0, got status $status: $out"
fi

# Two names on one line could be read as one package or as two, and both
# readings are a guess. Refusing names the line.
fixture "two packages on one line are refused"
manifest <<'TXT'
libasound2-dev pkg-config
TXT
out="$(cd "$work" && scripts/system-packages list 2>&1)"
status=$?
if (( status != 0 )) && grep -q "one package per line" <<<"$out"; then
  pass
else
  fail "expected a refusal naming the rule, got status $status: $out"
fi

# apt-get would read it as a flag, so a manifest could otherwise turn into
# arbitrary apt options at a distance.
fixture "a name beginning with a dash is refused"
manifest <<'TXT'
--reinstall
TXT
out="$(cd "$work" && scripts/system-packages list 2>&1)"
status=$?
if (( status != 0 )) && grep -q "not a package name" <<<"$out"; then
  pass
else
  fail "expected a refusal, got status $status: $out"
fi

# apt-get reads a trailing "-" as "remove this", "+" as "install this", and "^"
# as "install this whole tasksel task". A typed hyphen at the end of a line
# would otherwise uninstall a package while the step reported success.
fixture "a name carrying an apt action suffix is refused"
for suffix in - + ^; do
  manifest <<TXT
libasound2-dev$suffix
TXT
  out="$(cd "$work" && scripts/system-packages list 2>&1)"
  status=$?
  if (( status != 0 )) && grep -q "not a package name" <<<"$out"; then
    pass
  else
    fail "expected a refusal for the $suffix suffix, got status $status: $out"
  fi
done

# Version pinning is ordinary apt syntax and must survive the suffix rule.
fixture "a version-pinned name is kept"
manifest <<'TXT'
libasound2-dev=1.2.11-1
TXT
out="$(cd "$work" && scripts/system-packages list 2>&1)"
if [[ $out == "libasound2-dev=1.2.11-1" ]]; then
  pass
else
  fail "expected the pinned name through unchanged, got: $out"
fi

# The case the first draft of this script got wrong: it tested existence rather
# than readability, so an unreadable manifest reported success having installed
# nothing, and the missing header resurfaced as a compile error nobody could
# trace back to here.
fixture "an unreadable manifest fails rather than listing nothing"
manifest <<'TXT'
libasound2-dev
TXT
chmod 000 "$work/.github/system-packages.txt"
if [[ -r "$work/.github/system-packages.txt" ]]; then
  skip "running as a user that can read a mode-000 file"
else
  out="$(cd "$work" && scripts/system-packages list 2>&1)"
  status=$?
  if (( status != 0 )); then
    pass
  else
    fail "expected a failure, got exit 0 and: $out"
  fi
fi
chmod 644 "$work/.github/system-packages.txt"

# install is what the composite action calls. With no manifest it must reach no
# apt at all, which is the promise made to every repository that never writes
# one.
# Someone reading this log has usually just watched a build fail on a missing
# header. The no-op has to name the file, or the step is a silent line between
# them and the fix.
fixture "install runs no apt where there is no manifest, and says where the fix goes"
stub sudo <<'STUB'
#!/usr/bin/env bash
echo "sudo was called: $*" >&2
exit 1
STUB
out="$(cd "$work" && scripts/system-packages install 2>&1)"
status=$?
if (( status == 0 )) && ! grep -q "sudo was called" <<<"$out" &&
  grep -q ".github/system-packages.txt" <<<"$out"; then
  pass
else
  fail "expected no apt, exit 0, and the manifest path named; got status $status: $out"
fi

fixture "install passes the listed packages to apt-get"
manifest <<'TXT'
libasound2-dev
pkg-config
TXT
sudo_logging
dpkg_holding ""
(cd "$work" && scripts/system-packages install) > /dev/null 2>&1
out="$(cat "$work/sudo.log" 2>&1)"
if grep -qxF "apt-get update" <<<"$out" &&
  grep -qxF "apt-get install -y --no-install-recommends libasound2-dev pkg-config" <<<"$out"; then
  pass
else
  fail "apt-get was not called with the listed packages: $out"
fi

# The self-hosted case. A runner that keeps its state between jobs has the
# packages from the first job onward, so reaching apt again is work the run
# does not need and, on a host without sudo, a failure it does not deserve.
fixture "install reaches no apt where the host already has every package"
manifest <<'TXT'
libasound2-dev
pkg-config
TXT
stub sudo <<'STUB'
#!/usr/bin/env bash
echo "sudo was called: $*" >&2
exit 1
STUB
dpkg_holding "libasound2-dev pkg-config"
out="$(cd "$work" && scripts/system-packages install 2>&1)"
status=$?
if (( status == 0 )) && ! grep -q "sudo was called" <<<"$out"; then
  pass
else
  fail "expected no apt and exit 0, got status $status: $out"
fi

fixture "install passes only the packages the host lacks"
manifest <<'TXT'
libasound2-dev
pkg-config
TXT
sudo_logging
dpkg_holding "pkg-config"
(cd "$work" && scripts/system-packages install) > /dev/null 2>&1
out="$(cat "$work/sudo.log" 2>&1)"
if grep -qxF "apt-get install -y --no-install-recommends libasound2-dev" <<<"$out"; then
  pass
else
  fail "expected only the absent package installed: $out"
fi

fixture "a pinned name the host holds at that exact version is left alone"
manifest <<'TXT'
libasound2-dev=1.2.11-1
TXT
stub sudo <<'STUB'
#!/usr/bin/env bash
echo "sudo was called: $*" >&2
exit 1
STUB
dpkg_holding "libasound2-dev=1.2.11-1"
out="$(cd "$work" && scripts/system-packages install 2>&1)"
status=$?
if (( status == 0 )) && ! grep -q "sudo was called" <<<"$out"; then
  pass
else
  fail "expected the pin read as satisfied, got status $status: $out"
fi

# The pin is there to ask for that version, so a different one installed is
# not the package the manifest named.
fixture "a pinned name the host does not match at that version is installed"
manifest <<'TXT'
libasound2-dev=1.2.11-1
TXT
sudo_logging
dpkg_holding "libasound2-dev=9.9.9"
(cd "$work" && scripts/system-packages install) > /dev/null 2>&1
out="$(cat "$work/sudo.log" 2>&1)"
if grep -qxF "apt-get install -y --no-install-recommends libasound2-dev=1.2.11-1" <<<"$out"; then
  pass
else
  fail "expected the pinned name installed over the mismatched version: $out"
fi

# -W emits one record per match with no separator of its own. A package
# present for two architectures is the case that reaches this, and reading the
# two run together on one line gets every field wrong.
fixture "a package dpkg reports twice for two architectures reads as installed"
manifest <<'TXT'
libasound2-dev=1.2.11-1
TXT
stub sudo <<'STUB'
#!/usr/bin/env bash
echo "sudo was called: $*" >&2
exit 1
STUB
# This stub renders the caller's own -f= format rather than printing a fixed
# string, so the case is sensitive to the format install asks for. A stub that
# hardcoded two lines would pass with the newline dropped from the format --
# which is the whole bug -- because the stub, not dpkg, would be supplying the
# separator.
stub dpkg-query <<'STUB'
#!/usr/bin/env bash
format=""
for arg; do [[ $arg == -f=* ]] && format=${arg#-f=}; done
record=${format//'${Status}'/install ok installed}
record=${record//'${Version}'/1.2.11-1}
printf '%b%b' "$record" "$record"
STUB
out="$(cd "$work" && scripts/system-packages install 2>&1)"
status=$?
if (( status == 0 )) && ! grep -q "sudo was called" <<<"$out"; then
  pass
else
  fail "expected the two records read separately, got status $status: $out"
fi

# apt-get and dpkg-query both read these as patterns, so the name would
# install whatever matched and the installed check would answer about the
# first match rather than about this line.
fixture "a name reading as a glob pattern is refused"
for name in 'libasound2-*' 'libasound2-dev?' 'libasound[12]'; do
  manifest <<TXT
$name
TXT
  out="$(cd "$work" && scripts/system-packages list 2>&1)"
  status=$?
  if (( status != 0 )) && grep -q "reads as a pattern" <<<"$out"; then
    pass
  else
    fail "expected a refusal for $name, got status $status: $out"
  fi
done

# The runner host holds no sudo by design. A package genuinely missing there is
# the operator's to install, and the run has to say which one -- a build that
# instead fails later on the header names the compiler, not the manifest.
fixture "a missing package with no route to root fails naming it"
manifest <<'TXT'
libasound2-dev
pkg-config
TXT
stub sudo <<'STUB'
#!/usr/bin/env bash
exit 1
STUB
dpkg_holding "pkg-config"
if (( EUID == 0 )); then
  skip "running as root, where there is no route to root to withhold"
else
  out="$(cd "$work" && scripts/system-packages install 2>&1)"
  status=$?
  if (( status != 0 )) && grep -q "libasound2-dev" <<<"$out" &&
    ! grep -q "pkg-config" <<<"$out"; then
    pass
  else
    fail "expected a failure naming only the absent package, got status $status: $out"
  fi
fi

# A refusal must stop the install rather than fall through to an apt call with
# whatever survived the parse.
fixture "a refused manifest reaches no apt"
manifest <<'TXT'
libasound2-dev pkg-config
TXT
stub sudo <<'STUB'
#!/usr/bin/env bash
echo "sudo was called: $*" >&2
STUB
out="$(cd "$work" && scripts/system-packages install 2>&1)"
status=$?
if (( status != 0 )) && ! grep -q "sudo was called" <<<"$out"; then
  pass
else
  fail "expected a refusal before any apt call, got status $status: $out"
fi

report
