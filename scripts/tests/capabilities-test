#!/usr/bin/env bash
cat >/dev/null
[[ "$1" != test ]] || pwd >> "${MARKER:?}"
STUB
out="$(MARKER="$work/visited" ci_real)"
status=$?
if (( status != 0 )); then
  fail "the gate failed though every stubbed swift call succeeded (exit $status): $out"
elif [[ "$(sort "$work/visited" | tr '\n' ' ')" == "$work/apps/a $work/apps/b " ]]; then
