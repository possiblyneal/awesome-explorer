#!/usr/bin/env bash
set -uo pipefail

# Guards the one bug this detection work exists to prevent: a repository that
# gains a second language has that language silently skipped while the run stays
# green. Nothing else here fails visibly when it regresses, which is why it is
# worth a test at all.
#
# Everything is asked through the public surface -- scripts/ci, scripts/run,
# scripts/package, scripts/detect, and the `language_capabilities` subcommands
# -- from a scratch repository holding nothing but the manifests a case names.
# Where a real run is wanted, the toolchain is a stub on PATH that records what
# it was asked, so the dispatch is under test and no compiler is. Wiring is
# asked of `language_capabilities probe`, and dispatch of `CI_DRY_RUN=1`, which
# reports each pairing scripts/ci would run and runs none of them.
#
# Covered: the twelve-by-six probe table, dispatch under CI_DRY_RUN=1, and real
# runs of ci, security, run, integration, fix, and package against stubbed
# toolchains. fix is asked for both halves in order, and a language with no
# lint autofix must not fail it. The integration tier's cases run in both
# directions: not-applicable with no tier, dispatch on a tier under a unit, the
# gate's pytest and `go test` runs leaving it out, and the tier's own run
# naming it.
#
# Not `set -e`: a failing assertion is recorded and the remaining cases still
# run, so one break does not hide the rest.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/harness.sh
source "$repo_root/scripts/tests/libs/harness.sh"

# The supported set and the probe are the module's interface; a suite calling
# them is a caller like any other. Sourced once, here, and every subcommand
# below is run from inside the fixture so the manifests it reads are the case's.
# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=libs/detect.sh
source "$repo_root/scripts/libs/detect.sh"

# The gate, as scripts/ci reports it under the dry run. Stdin is /dev/null for
# every command below that a stub might answer: a stub that drains stdin would
# otherwise block on the suite's own.
ci() {
  (cd "$work" && CI_DRY_RUN=1 scripts/ci 2>&1 </dev/null)
}
ci_real() {
  (cd "$work" && scripts/ci 2>&1 </dev/null)
}

# scripts/run starts with scripts/doctor, which is another suite's subject and
# would fail here on the toolchains each case deliberately does not have. The
# copy of scripts in the fixture is where a stub answers it.
#
# run_stdin hands the program whatever stdin the suite was given. That is what
# scripts/run is for, and one case below is about it; every other case takes
# run_real, which closes it like the rest of the suite.
run_stdin() {
  printf '#!/usr/bin/env bash\nexit 0\n' > "$work/scripts/doctor"
  chmod +x "$work/scripts/doctor"
  (cd "$work" && scripts/run "$@" 2>&1)
}
run_real() {
  run_stdin "$@" </dev/null
}

capabilities() {
  (cd "$work" && language_capabilities "$@" 2>&1 </dev/null)
}

# Whether scripts/ci found a manifest no root manifest names. The detection
# verdict comes before any dispatch, so the dry run answers it.
orphaned() {
  grep -qE '^detection +FAIL' <<<"$(ci)"
}

go_mod() {
  printf 'module example.com/%s\n\ngo 1.22\n' "$(basename "$1")" > "$1/go.mod"
}

assert_dispatches() {
  local lang="$1" out="$2" check expected
  for check in lint format-check typecheck test build; do
    expected=would-run
    case "$check:$lang" in
      typecheck:go|typecheck:rust|typecheck:swift|typecheck:kotlin|build:python)
        expected=not-applicable
        ;;
    esac

    if ! grep -qE "^$check +${expected} +$lang$" <<<"$out"; then
      fail "$check does not report $expected for $lang"
      return
    fi
  done
  pass
}

assert_absent() {
  local lang="$1" out="$2"
  if grep -q " $lang\$" <<<"$out"; then
    fail "$lang dispatches in a repository that does not contain it"
    return
  fi
  pass
}

echo "capabilities-test"

current="supported languages"
expected=$'node\npython\ngo\nrust\nswift\nkotlin'
if [[ "$(language_capabilities supported)" == "$expected" ]]; then
  pass
else
  fail "the interface does not report the six supported languages in order"
fi

# --- every pairing, wired or absent, held as one table -------------------------

# The whole point of the probe: a language dropped from one capability, or an
# adapter deleted by accident, changes one line here. The absent cells are the
# ones this template has chosen not to wire -- typecheck where the compiler is
# the typecheck, build where Python has none, and the delivery adapters whose
# gap the capabilities module explains beside where each would go. Every other
# cell is wired, and a `dev` capability no longer exists to have a row at all.
current="the probe reports every capability and language pairing"
absent='typecheck:go typecheck:rust typecheck:swift typecheck:kotlin build:python
integration:rust integration:swift integration:kotlin
lint-fix:go lint-fix:swift lint-fix:kotlin
run:swift package:node package:python package:swift package:kotlin'
out="$(language_capabilities probe)"
missing=""
for cap in lint format-check typecheck test build audit toolchain format-write lint-fix integration run package; do
  for lang in node python go rust swift kotlin; do
    expected=wired
    [[ " ${absent//$'\n'/ } " != *" $cap:$lang "* ]] || expected=absent
    grep -qE "^$cap +$expected +$lang$" <<<"$out" || missing="$missing $cap:$lang=$expected"
  done
done
if [[ -n "$missing" ]]; then
  fail "the probe does not report:$missing"
elif (( $(wc -l <<<"$out") != 72 )); then
  fail "the probe reports $(wc -l <<<"$out") pairings rather than 72 -- a capability or language it was not asked about"
elif grep -q '^dev ' <<<"$out"; then
  fail "a dev capability survives in the probe"
else
  pass
fi

# --- one language, and only that one -----------------------------------------

fixture "capability outcomes"
go_mod "$work"
out="$(capabilities run --dry-run lint typecheck)"
status=$?
if (( status == 0 )) &&
  grep -qE '^lint +would-run +go$' <<<"$out" &&
  grep -qE '^typecheck +not-applicable +go$' <<<"$out"; then
  pass
else
