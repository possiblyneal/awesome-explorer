# The two facts vary independently, so the audit checks values and never the
# pairing. A scheduled job runs oneshot and ships a quadlet; a library runs
# nothing and still ships. Both look odd and both are legal.
fixture "every run and ship pairing is accepted"
i=0
for run in oneshot longlived none; do
  for kind in none quadlet executable; do
    i=$((i + 1))
    if [[ "$kind" == executable ]]; then
      declare_unit "unit$i" "$run" executable linux-amd64 macos-arm64
    else
      declare_unit "unit$i" "$run" "$kind"
    fi
    write "apps/unit$i/src/main.py"
  done
done
assert_passes

# A check that did not run is not a check that passed. The fixture's PATH holds
# only what the audit itself needs -- its interpreter, dirname for resolving its
# own root, and git for the enumeration -- so jq is absent and the audit must
# say so rather than report a pass over a file it never opened. If the script
# grows another dependency this case fails loudly with the output, which is the
# point: a silently shortened run is what the four states exist to prevent.
fixture "a missing jq makes the fact check unavailable rather than passing"
declare_unit billing
write apps/billing/src/main.py
git -C "$work" add -A > /dev/null 2>&1
output="$( (cd "$work" && PATH="$(minimal_path bash dirname git)" ./scripts/structure) 2>&1 )"
if grep -qE '^unit-facts +unavailable' <<< "$output"; then
  pass
else
  fail "expected unit-facts unavailable, got: $output"
fi

