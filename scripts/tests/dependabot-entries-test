# A workspace file says where the modules are; the modules are what Dependabot
# reads, so go.work earns no entry of its own and must not be reported as owing
# one. Whether an entry at its directory would also reach those modules is the
# service's own discovery behaviour and it moves -- dependabot/dependabot-core#14909,
# 2026-05-05 -- which is why the table maps manifests rather than tracking it.
fixture "a workspace file earns no entry" "$VERSION
  - package-ecosystem: gomod
    directory: /apps/api
    schedule:
      interval: weekly" go.work apps/api/go.mod
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
  fail "reported '$got', which is a workspace file rather than a manifest"
fi


# The decision the operator made: the six the template detects, plus docker for
# the Containerfiles the layout gives a place, and nothing else. A manifest
# outside that vocabulary is a shape the rest of the checks cannot see, and
# reporting it here would promise an entry the derivation will not write.
fixture "a manifest outside the mapped set is not reported" "$VERSION
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly" requirements.txt build.gradle Gemfile
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
