fixture "a glob directory covers what it matches" "$VERSION
  - package-ecosystem: npm
    directories:
      - /apps/*
    schedule:
      interval: weekly" apps/one/package.json apps/two/package.json
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
  fail "a glob directory left '$got' reported"
fi


# The directories block ends at the next key. Running past it would read the
# schedule's own lines as directories and match nothing, or worse, everything.
fixture "a directories list ends at the next key" "$VERSION
  - package-ecosystem: gomod
    directories:
      - /apps/one
    schedule:
      interval: weekly
  - package-ecosystem: gomod
    directory: /apps/two
    schedule:
