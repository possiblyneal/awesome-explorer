#!/usr/bin/env bash
set -uo pipefail

# Asserts that libs/dependabot.sh names the tracked manifests no entry watches.
#
# The failure this exists for is silent in both directions, and that is why it
# is worth a suite of its own. A manifest with no entry gets no update pull
# request and no error: the config is valid YAML, the file's own check run is
# green, and the only symptom is a bump that never arrives. A false report is
# just as quiet in practice -- scripts/doctor prints a line telling the operator
# to derive an entry that is already there, and the operator learns to skip the
# line.
#
# So the cases here run in both directions: every shape that must be read as
# watched -- the singular and plural keys, a glob directory, a second entry
# after a list, a uv entry over a pyproject.toml with uv.lock beside it, one
# docker entry over every Containerfile in its directory -- and every shape that
# must not be: a commented-out entry, a workspace file, a manifest outside the
# mapped set, a container ignore file, an untracked one, and an npm workspace
# member, still named because the doctor advisory rather than the library
# carries the workspace exception.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=libs/harness.sh
source "$repo_root/scripts/tests/libs/harness.sh"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../libs/dependabot.sh
source "$repo_root/scripts/libs/dependabot.sh"


# A scratch repository holding the given config, plus whatever manifests the
# case names as paths after it. Everything is committed to the index, because
# the question is about the tracked set: what Dependabot reads is the pushed
# tree, so an untracked manifest is not one of its manifests.
fixture() {
  local name="$1" config="$2"
  shift 2

  scratch_repo
  current="$name"

  mkdir -p "$work/.github"
  printf '%s\n' "$config" > "$work/.github/dependabot.yml"

  local manifest
  for manifest in "$@"; do
    mkdir -p "$work/$(dirname "$manifest")"
    printf '\n' > "$work/$manifest"
  done

  git -C "$work" add -A
}


# The answer as one space-separated line, so a case asserts against the whole
# of it rather than grepping for one path and passing on a partial read.
unwatched_in() {
  local answer
  answer="$(cd "$work" && dependabot_unwatched_manifests .github/dependabot.yml)"
  printf '%s' "${answer//$'\n'/ }"
}


VERSION='version: 2
updates:'

echo "dependabot-entries-test"


fixture "a root manifest with its entry is watched" "$VERSION
  - package-ecosystem: pip
    directory: /
    schedule:
      interval: weekly" pyproject.toml
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
  fail "reported '$got' for a manifest whose entry is right there"
fi


fixture "a root manifest with no entry is reported" "$VERSION
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly" pyproject.toml
got="$(unwatched_in)"
if [[ "$got" == "pyproject.toml" ]]; then
  pass
else
  fail "reported '$got' rather than the unwatched pyproject.toml"
fi


# The case the rule exists for: a nested module under apps/, which is where a
# repository following this template's layout keeps its units. An entry's
# directory is the manifest's own directory, so one at / does not reach it.
fixture "a nested manifest is not covered by the root entry" "$VERSION
  - package-ecosystem: gomod
    directory: /
    schedule:
      interval: weekly" go.mod apps/api/go.mod
got="$(unwatched_in)"
if [[ "$got" == "apps/api/go.mod" ]]; then
  pass
else
  fail "reported '$got', so a module under apps/ would age unwatched"
fi


# The ecosystem has to match as well as the directory. An entry naming the
# wrong one for a manifest watches nothing and must not silence it.
fixture "an entry for another ecosystem does not cover the manifest" "$VERSION
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly" pyproject.toml
got="$(unwatched_in)"
if [[ "$got" == "pyproject.toml" ]]; then
  pass
else
  fail "an npm entry read as covering a pyproject.toml"
fi


# Both keys are valid and a hand-edit or a formatter turns one into the other.
# Reading only the singular reports every manifest under a plural entry as
# unwatched, which is the check inventing a gap rather than finding one.
fixture "a directories list covers each of its members" "$VERSION
  - package-ecosystem: cargo
    directories:
      - /apps/one
      - /apps/two
    schedule:
      interval: weekly" apps/one/Cargo.toml apps/two/Cargo.toml
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
