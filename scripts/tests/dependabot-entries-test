# An untracked manifest is not in the pushed tree, so it is not one Dependabot
# reads. This is the case a working-tree search gets wrong: a gitignored
# checkout of the repository inside itself contributes manifests that are not
# in the repository at all, and an entry derived from one fails the whole run.
fixture "an untracked manifest is not reported" "$VERSION
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly"
mkdir -p "$work/.claude/worktrees/agent-one"
printf '\n' > "$work/.claude/worktrees/agent-one/pyproject.toml"
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
  fail "reported '$got', which is not in the repository"
fi


# YAML mapping keys are unordered, so an entry opening with `schedule:` is the
# same entry. Reading the key's position rather than the entry boundary carries
# the previous entry's ecosystem onto this one's directory and reports a real
# gap as watched -- the one failure here that is silent rather than noisy.
fixture "an entry whose ecosystem is not its first key is read whole" "$VERSION
  - package-ecosystem: gomod
    directory: /apps/b
    schedule:
      interval: weekly
  - schedule:
      interval: weekly
    package-ecosystem: npm
    directory: /apps/a" apps/b/go.mod apps/a/go.mod apps/a/package.json
got="$(unwatched_in)"
if [[ "$got" == "apps/a/go.mod" ]]; then
  pass
else
  fail "reported '$got'; apps/a/go.mod is watched by nothing and must be named"
fi


# A blank line between members is a formatting choice. Ending the list there
# drops every member after it and reports their manifests unwatched.
fixture "a blank line inside a directories list separates members" "$VERSION
  - package-ecosystem: gomod
    directories:
      - /apps/b

      - /apps/c
    schedule:
      interval: weekly" apps/b/go.mod apps/c/go.mod
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
  fail "a blank line ended the list and left '$got' reported"
fi


fixture "a comment line inside a directories list separates members" "$VERSION
  - package-ecosystem: cargo
    directories:
      - /apps/b
      # the second module
      - /apps/c
    schedule:
