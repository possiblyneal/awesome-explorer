# An empty answer and an unread tracked set look identical, so the caller has to
# be able to tell them apart or it reports a green row over nothing read.
fixture "an unreadable tracked set is a failure, not an empty answer" "$VERSION
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly"
outside="$(mktemp -d)"
mkdir -p "$outside/.github"
cp "$work/.github/dependabot.yml" "$outside/.github/dependabot.yml"
if (cd "$outside" && dependabot_unwatched_manifests .github/dependabot.yml >/dev/null 2>&1); then
  fail "reported success outside a repository, where nothing was read"
else
  pass
fi
rm -rf "$outside"


# An entry holds sequences of its own -- a groups pattern list, an ignore, an
# allow -- and a `-` inside one is not a new entry. Reading it as a boundary
# clears the ecosystem before the directory below it is read, which reports the
# entry's own manifest unwatched. The payload's entries put directory first,
# which is why nothing else here catches it.
fixture "a nested sequence inside an entry is not an entry boundary" "$VERSION
  - package-ecosystem: npm
    groups:
      npm:
        patterns:
          - \"*\"
    ignore:
      - dependency-name: left-pad
    directory: /apps/a
    schedule:
      interval: weekly" apps/a/package.json
got="$(unwatched_in)"
if [[ -z "$got" ]]; then
  pass
else
  fail "a groups list was read as an entry boundary, leaving '$got' reported"
fi


# A block sequence may sit at its key's own column as well as past it, and
# several formatters write it that way. Requiring the deeper indentation reads
# each member as a new entry and emits nothing.
fixture "a directories list at its key's own indentation is read" "$VERSION
